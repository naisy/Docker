########################################
# nodejs
########################################
# https://github.com/nodesource/distributions/blob/master/README.md
# https://deb.nodesource.com/setup_14.x - Node.js 14 LTS "Fermium" (recommended)
# https://deb.nodesource.com/setup_16.x - Node.js 16 "Gallium"
# https://deb.nodesource.com/setup_18.x - Node.js 18 "Eighteen" (current)
# Ubuntu 26.04のopenmpi-docはnode-mathjax-full経由でUbuntuのnodejsに依存し、nodesourceのnodejsと共存できないため入れない

RUN curl -fsSL https://deb.nodesource.com/setup_26.x | sudo -E bash - \
    && sudo apt-get update \
    && sudo apt-get install -y \
         nodejs \
    && dpkg --compare-versions "$(node --version | cut -c2-)" ge 26.13.0 \
    && sudo npm install -g npm@12.2.1 --no-audit --no-fund \
    # npm 12.2.1にも同梱される依存ライブラリの修正版を適用する \
    # CVE-2026-111497はnodejs本体、Undici/ip-addressの修正はnpm同梱分にも必要 \
    && cd /tmp \
    && npm pack --ignore-scripts undici@6.29.1 ip-address@10.7.5 \
    && sudo tar -xzf undici-6.29.1.tgz --strip-components=1 -C "$(npm root -g)/npm/node_modules/undici" \
    && sudo tar -xzf ip-address-10.7.5.tgz --strip-components=1 -C "$(npm root -g)/npm/node_modules/ip-address" \
    && rm -f undici-6.29.1.tgz ip-address-10.7.5.tgz \
    && sudo apt autoremove -y \
    && sudo rm -rf /var/lib/apt/lists/*


########################################
# mermaid-cli
########################################
# npm 12はinstall scriptsを既定で実行しないため、Chromeを取得するpuppeteerのpostinstallだけを許可する
# mermaid-cli 12.0.0が同梱するkatexを修正版に差し替える
RUN sudo PUPPETEER_CACHE_DIR=/home/$USERNAME/.cache/puppeteer npm install -g @mermaid-js/mermaid-cli@12.0.0 --allow-scripts=puppeteer --no-audit --no-fund \
    && sudo chown -R $USERNAME:$USERNAME /home/$USERNAME/.cache/puppeteer \
    && MERMAID_CLI_DIR="$(npm root -g)/@mermaid-js/mermaid-cli" \
    && cd /tmp \
    # mermaid 12.2.0はkatex ^0.18.0を要求するため0.18系の最新を使う \
    # katex 0.18.11はcommander ^15.0.0を要求するため、katex配下のcommanderも差し替える \
    && npm pack --ignore-scripts katex@0.18.11 commander@15.0.0 \
    && sudo tar -xzf katex-0.18.11.tgz --strip-components=1 -C "$MERMAID_CLI_DIR/node_modules/katex" \
    && sudo tar -xzf commander-15.0.0.tgz --strip-components=1 -C "$MERMAID_CLI_DIR/node_modules/katex/node_modules/commander" \
    && rm -f katex-0.18.11.tgz commander-15.0.0.tgz \
    && sudo node -e 'const fs = require("node:fs"); const f = process.argv[1]; const p = JSON.parse(fs.readFileSync(f)); p.dependencies.katex = "^0.18.11"; p.overrides = {...p.overrides, katex: "^0.18.11"}; fs.writeFileSync(f, JSON.stringify(p, null, 2) + "\n");' "$MERMAID_CLI_DIR/package.json" \
    && node -e 'if (require(process.argv[1]).version !== "0.18.11") process.exit(1)' "$MERMAID_CLI_DIR/node_modules/katex/package.json" \
    && node -e 'if (require(process.argv[1]).version !== "15.0.0") process.exit(1)' "$MERMAID_CLI_DIR/node_modules/katex/node_modules/commander/package.json" \
    && npm ls -g --all > /dev/null


